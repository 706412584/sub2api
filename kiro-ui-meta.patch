+				switch v := value.(type) {
+				case bool:
+					return v
+				case string:
+					if b, err := strconv.ParseBool(strings.TrimSpace(v)); err == nil {
+						return b
+					}
+				}
+			}
+		}
+	}
+	return false
+}
