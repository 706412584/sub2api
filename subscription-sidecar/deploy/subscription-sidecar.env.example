# Copy to /etc/sub2api/subscription-sidecar.env (Linux) or a local .env (Windows).
# NEVER commit real subscription URLs or admin keys.

SIDECAR_SUBSCRIPTION_URL=
# Or use a local file instead of URL:
# SIDECAR_SUBSCRIPTION_FILE=/var/lib/sub2api/subscription.yaml

# Native Windows stack often uses 18080; Linux package default may be 8080.
SIDECAR_SUB2API_BASE_URL=http://127.0.0.1:18080
SIDECAR_ADMIN_API_KEY=

SIDECAR_NAME_PREFIX=sidecar-a-
SIDECAR_PROTOCOL=socks5
SIDECAR_BIND_ADDRESS=127.0.0.1
SIDECAR_BASE_PORT=21080
SIDECAR_MAX_PORTS=20
SIDECAR_SYNC_INTERVAL=5m

SIDECAR_MIHOMO_BINARY=mihomo
SIDECAR_MIHOMO_CONFIG_PATH=data/mihomo-config.yaml
SIDECAR_MIHOMO_DATA_DIR=data/mihomo

# Optional filters (comma-separated substrings of node names)
# SIDECAR_NODE_ALLOW_CONTAINS=US,JP,SG

# SIDECAR_DRY_RUN=1
# SIDECAR_SKIP_ENGINE=1
# SIDECAR_ONCE=1
